{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "nextjs",
      "installCommand": "cd ../.. && bun install",
      "buildCommand": "cd ../.. && if [ \"$VERCEL_ENV\" = \"production\" ]; then bun run db:migrate; fi && bun run --filter web build"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
