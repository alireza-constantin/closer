{
  "name": "Closer",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.4.2",
      "zod": "^4.4.3",
      "typescript": "^6.0.3",
      "@types/node": "^26.2.0",
      "lucide-react": "^1.27.0",
      "next-themes": "^0.4.6",
      "react": "^19.2.8",
      "react-dom": "^19.2.8",
      "sonner": "^2.0.7",
      "better-auth": "1.7.1",
      "@tailwindcss/postcss": "^4.3.3",
      "@types/react": "^19.2.17",
      "@types/react-dom": "^19.2.3",
      "tailwindcss": "^4.3.3"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "build": "bun run --filter '*' build",
    "check-types": "bun run --filter '*' check-types",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "test": "bun test",
    "api:run": "go -C apps/api run ./cmd/server",
    "api:schema:apply:test": "go -C apps/api run ./cmd/testdb-schema apply",
    "api:schema:reset:test": "go -C apps/api run ./cmd/testdb-schema reset",
    "api:admin-bootstrap": "go -C apps/api run ./cmd/admin-bootstrap",
    "api:admin-recover": "go -C apps/api run ./cmd/admin-recover",
    "api:test": "go -C apps/api test ./...",
    "api:build": "go -C apps/api build -o build/server ./cmd/server",
    "dev:web": "bun run --filter web dev",
    "db:push": "bun run --filter @Closer/db db:push",
    "db:push:production": "tsx scripts/db-push-production.ts",
    "db:studio": "bun run --filter @Closer/db db:studio",
    "db:start": "bun run --filter @Closer/db db:start",
    "db:watch": "bun run --filter @Closer/db db:watch",
    "db:stop": "bun run --filter @Closer/db db:stop",
    "db:down": "bun run --filter @Closer/db db:down",
    "admin:bootstrap": "bun run scripts/admin-bootstrap.ts",
    "admin:recover": "bun run scripts/admin-recover.ts",
    "deploy:setup": "vercel link",
    "dev:vercel": "vercel dev -L",
    "env:preview": "tsx scripts/sync-vercel-env.ts preview",
    "env:production": "tsx scripts/sync-vercel-env.ts production",
    "deploy": "vercel deploy",
    "deploy:prod": "vercel deploy --prod",
    "deploy:check": "vercel deploy --dry"
  },
  "dependencies": {
    "@Closer/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@Closer/config": "workspace:*",
    "@types/node": "catalog:",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.8",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tsx": "^4.23.1",
    "typescript": "catalog:",
    "vercel": "^58.1.0"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  },
  "packageManager": "bun@1.4.2"
}
