# Closer local environment template. Copy values into apps/web/.env.local.
# Never put real secrets or database credentials in this file.

# Database
# Required for app runtime and Drizzle migrations.
DATABASE_URL=

# Realtime
# Optional. Required only when DATABASE_URL uses a transaction pooler or
# otherwise cannot keep a session-level PostgreSQL LISTEN connection open.
# Use a direct, session-capable PostgreSQL URL when needed.
REALTIME_DATABASE_URL=

# Authentication
# Required: generate a unique secret of at least 32 characters.
BETTER_AUTH_SECRET=
# Required locally. On Vercel, this can be derived from the platform URL unless
# you need to set a canonical custom domain explicitly.
BETTER_AUTH_URL=http://localhost:3001

# Admin
# Optional for a consumer-only deployment; required to authorize Admin access.
ADMIN_USER_ID=
# TEMPORARY bootstrap-only: provide to `bun run admin:bootstrap`, then remove.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
# TEMPORARY recovery-only: provide to `bun run admin:recover`, then remove.
ADMIN_RECOVERY_PASSWORD=

# Runtime/platform values
# NODE_ENV is set by Next.js/hosting; the application defaults it to development.
# VERCEL_ENV, VERCEL_URL, and VERCEL_PROJECT_PRODUCTION_URL are supplied by
# Vercel and are used to derive BETTER_AUTH_URL when it is not explicitly set.
# Do not set these manually in a Vercel project.

# Local tooling only (optional)
# SKIP_ENV_VALIDATION is an internal validation bypass. Leave unset in
# production.
# SKIP_ENV_VALIDATION=1
# Optional development performance script settings; defaults are shown.
# CLOSER_PERF_BASE_URL=http://localhost:3100
# CLOSER_PERF_REPEATS=5

# Optional Next.js build output directory override.
# CLOSER_NEXT_DIST_DIR=.next-custom
