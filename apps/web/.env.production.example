# CLOSER PRODUCTION ENVIRONMENT
# Neon PRODUCTION branch only.
# Configure these as Vercel Production Environment Variables.
# Do not create or commit a real .env.production file.

# Pooled connection for normal web/application queries.
DATABASE_URL=
# Direct connection used by migrations.
DATABASE_URL_UNPOOLED=
# Direct/session-capable connection for persistent LISTEN/NOTIFY.
REALTIME_DATABASE_URL=

# Better Auth runtime configuration.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

# Permanent Admin authorization value.
ADMIN_USER_ID=

# TEMPORARY: use only during Admin provisioning, then remove both values.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# TEMPORARY: use only during Admin recovery, then remove the value.
ADMIN_RECOVERY_PASSWORD=
