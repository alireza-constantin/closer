# CLOSER TEST ENVIRONMENT
# Neon TEST branch only. Copy this file to apps/web/.env.test.local.
# Never use the Production or normal Development branch here.
# Automated integration tests may create, delete, or reset test data.

# Dedicated direct/session-capable Neon TEST branch URL.
# It must not equal DATABASE_URL from the Development environment.
TEST_DATABASE_URL=

# Required by the test harness through @Closer/env/server.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001
NODE_ENV=test
