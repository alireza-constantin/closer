# Copy this file to apps/api/.env.local and replace the placeholders.
# Keep DATABASE_URL on the locally installed PostgreSQL server and closer_dev.
HTTP_ADDR=127.0.0.1:8080
DATABASE_URL=postgres://postgres:CHANGE_ME@127.0.0.1:5435/closer_dev?sslmode=disable
CLOSER_TRUSTED_ORIGINS=http://localhost:5173
